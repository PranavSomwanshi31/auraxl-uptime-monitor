# AuraXL Uptime Monitor — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# === Target ===
TARGET_URL=https://auraxl.com

# === Monitoring intervals ===
MONITOR_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_MS=10000
DEGRADED_RESPONSE_TIME_MS=3000

# === Database ===
# Leave empty to use SQLite (local dev).
# Set to a PostgreSQL DSN for Render / production.
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# === Security ===
# Random secret used to protect POST /api/check-now
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MANUAL_CHECK_TOKEN=change-me-to-a-random-secret

# === Server ===
PORT=10000
